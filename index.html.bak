                    <div class="flex items-start gap-3">
                        <div class="p-2.5 rounded-xl bg-teal-50 group-hover:bg-teal-100 transition-colors shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-teal-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 17V7m0 10a2 2 0 01-2 2H5a2 2 0 01-2-2V7a2 2 0 012-2h2a2 2 0 012 2m0 10a2 2 0 002 2h2a2 2 0 002-2M9 7a2 2 0 012-2h2a2 2 0 012 2m0 10V7" /></svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-bold text-slate-800 text-sm mb-0.5 group-hover:text-teal-600 transition-colors">Text Diff</h3>
                            <p class="text-xs text-slate-500">Compare two texts side-by-side with additions and deletions highlighted.</p>
                        </div>
                    </div>
                </button>

                <button onclick="switchTab('uuidTab')" class="group bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md hover:border-indigo-300 p-5 text-left transition-all">
                    <div class="flex items-start gap-3">
                        <div class="p-2.5 rounded-xl bg-indigo-50 group-hover:bg-indigo-100 transition-colors shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 14v6m-3-3h6M6 10h2a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v2a2 2 0 002 2zm10 0h2a2 2 0 002-2V6a2 2 0 00-2-2h-2a2 2 0 00-2 2v2a2 2 0 002 2zM6 20h2a2 2 0 002-2v-2a2 2 0 00-2-2H6a2 2 0 00-2 2v2a2 2 0 002 2z" /></svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-bold text-slate-800 text-sm mb-0.5 group-hover:text-indigo-600 transition-colors">UUID Generator</h3>
                            <p class="text-xs text-slate-500">Generate UUID v4, v7, random hex, base64, and byte arrays.</p>
                        </div>
                    </div>
                </button>

            </div>

            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-3">Network Testing</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 mb-8">

                <button onclick="switchTab('dnsTab')" class="group bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md hover:border-blue-300 p-5 text-left transition-all">
                    <div class="flex items-start gap-3">
                        <div class="p-2.5 rounded-xl bg-blue-50 group-hover:bg-blue-100 transition-colors shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-blue-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" /></svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-bold text-slate-800 text-sm mb-0.5 group-hover:text-blue-600 transition-colors">DNS Lookup</h3>
                            <p class="text-xs text-slate-500">Query A, AAAA, MX, TXT, CNAME, NS, SOA, and CAA records.</p>
                        </div>
                    </div>
                </button>

                <button onclick="switchTab('sslcheckTab')" class="group bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md hover:border-emerald-300 p-5 text-left transition-all">
                    <div class="flex items-start gap-3">
                        <div class="p-2.5 rounded-xl bg-emerald-50 group-hover:bg-emerald-100 transition-colors shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-emerald-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" /></svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-bold text-slate-800 text-sm mb-0.5 group-hover:text-emerald-600 transition-colors">SSL Checker</h3>
                            <p class="text-xs text-slate-500">Inspect remote TLS certificates, chain, and protocol versions.</p>
                        </div>
                    </div>
                </button>

                <button onclick="switchTab('headersTab')" class="group bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md hover:border-purple-300 p-5 text-left transition-all">
                    <div class="flex items-start gap-3">
                        <div class="p-2.5 rounded-xl bg-purple-50 group-hover:bg-purple-100 transition-colors shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-purple-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" /></svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-bold text-slate-800 text-sm mb-0.5 group-hover:text-purple-600 transition-colors">HTTP Headers</h3>
                            <p class="text-xs text-slate-500">Analyze HTTP response headers with security scoring.</p>
                        </div>
                    </div>
                </button>

                <button onclick="switchTab('whoisTab')" class="group bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md hover:border-amber-300 p-5 text-left transition-all">
                    <div class="flex items-start gap-3">
                        <div class="p-2.5 rounded-xl bg-amber-50 group-hover:bg-amber-100 transition-colors shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-amber-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-bold text-slate-800 text-sm mb-0.5 group-hover:text-amber-600 transition-colors">WHOIS</h3>
                            <p class="text-xs text-slate-500">Look up domain registration and ownership information.</p>
                        </div>
                    </div>
                </button>

                <button onclick="switchTab('mailTab')" class="group bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md hover:border-red-300 p-5 text-left transition-all">
                    <div class="flex items-start gap-3">
                        <div class="p-2.5 rounded-xl bg-red-50 group-hover:bg-red-100 transition-colors shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-red-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-bold text-slate-800 text-sm mb-0.5 group-hover:text-red-600 transition-colors">Mail Tester</h3>
                            <p class="text-xs text-slate-500">Check MX, SMTP, STARTTLS, SPF, DKIM, and DMARC for any domain.</p>
                        </div>
                    </div>
                </button>

                <button onclick="switchTab('portscanTab')" class="group bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-md hover:border-orange-300 p-5 text-left transition-all">
                    <div class="flex items-start gap-3">
                        <div class="p-2.5 rounded-xl bg-orange-50 group-hover:bg-orange-100 transition-colors shrink-0">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-orange-600" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01" /></svg>
                        </div>
                        <div class="flex-1 min-w-0">
                            <h3 class="font-bold text-slate-800 text-sm mb-0.5 group-hover:text-orange-600 transition-colors">Port Scanner</h3>
                            <p class="text-xs text-slate-500">Scan common ports with presets for web, mail, database, and remote access.</p>
                        </div>
                    </div>
                </button>

            </div>
        </div>

        <div id="pfxTab" class="max-w-2xl mx-auto hidden">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-800 mb-2">Secure PFX Extractor</h2>
                <p class="text-slate-500 leading-relaxed">Extract certificates and private keys from PKCS#12 archives. All decryption happens safely offline in your browser's memory.</p>
            </div>
            
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8 space-y-5">
                <div>
                    <label for="pfxFile" class="block text-sm font-semibold text-slate-700 mb-1.5">Select PFX / P12 File</label>
                    <input type="file" id="pfxFile" accept=".pfx,.p12" 
                        class="w-full text-sm text-slate-500 file:mr-4 file:py-2.5 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-blue-50 file:text-blue-700 hover:file:bg-blue-100 border border-slate-200 rounded-lg cursor-pointer transition-all bg-slate-50">
                </div>

                <div id="passwordGroup" class="hidden opacity-0 transition-opacity duration-300">
                    <label for="pfxPass" class="block text-sm font-semibold text-slate-700 mb-1.5">Archive Password</label>
                    <input type="password" id="pfxPass" placeholder="Enter password to decrypt" 
                        class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all text-sm">
                </div>
                
                <button id="unlockBtn" class="hidden w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg shadow-sm transition-colors disabled:opacity-50 mt-2 flex justify-center items-center gap-2">
                    Unlock Vault
                </button>
                
                <div id="status" class="text-center font-medium mt-4 text-sm text-slate-600 hidden"></div>
            </div>

            <div id="certViewer" class="hidden mt-8">
                <h3 class="text-lg font-bold text-slate-800 mb-4 flex items-center gap-2">
                    Extracted Details 
                    <span class="text-xs font-normal bg-emerald-100 text-emerald-800 px-2 py-1 rounded-full">Auto-saved to Vault</span>
                </h3>
                <div class="bg-white border border-slate-200 rounded-lg overflow-hidden mb-4 shadow-sm text-sm">
                    <dl class="divide-y divide-slate-100">
                        <div class="px-4 py-3 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6"><dt class="font-medium text-slate-500">Common Name</dt><dd class="mt-1 text-slate-900 sm:mt-0 sm:col-span-2 font-semibold break-all" id="pfxCN">-</dd></div>
                        <div class="px-4 py-3 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6 bg-slate-50"><dt class="font-medium text-slate-500">Organization</dt><dd class="mt-1 text-slate-900 sm:mt-0 sm:col-span-2 break-all" id="pfxOrg">-</dd></div>
                        <div class="px-4 py-3 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6"><dt class="font-medium text-slate-500">Issuer</dt><dd class="mt-1 text-slate-900 sm:mt-0 sm:col-span-2 break-all" id="pfxIssuer">-</dd></div>
                        <div class="px-4 py-3 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6 bg-slate-50"><dt class="font-medium text-slate-500">Valid From</dt><dd class="mt-1 text-slate-900 sm:mt-0 sm:col-span-2" id="pfxValidFrom">-</dd></div>
                        <div class="px-4 py-3 sm:grid sm:grid-cols-3 sm:gap-4 sm:px-6"><dt class="font-medium text-slate-500">Valid To</dt><dd class="mt-1 text-slate-900 sm:mt-0 sm:col-span-2" id="pfxValidTo">-</dd></div>
                    </dl>
                </div>
                <details class="group mb-6">
                    <summary class="flex items-center gap-2 cursor-pointer text-sm font-medium text-blue-600 hover:text-blue-800 select-none w-max">
                        <svg class="w-4 h-4 transition-transform group-open:rotate-90" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" /></svg>
                        View Raw OpenSSL Output
                    </summary>
                    <div class="mt-3"><pre id="pfxDetailsText" class="bg-slate-800 text-emerald-400 rounded-lg p-4 text-xs font-mono overflow-x-auto whitespace-pre-wrap break-words"></pre></div>
                </details>
                <button id="downloadBtn" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-3 px-4 rounded-lg shadow-sm transition-colors flex items-center justify-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M3 17a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zm3.293-7.707a1 1 0 011.414 0L9 10.586V3a1 1 0 112 0v7.586l1.293-1.293a1 1 0 111.414 1.414l-3 3a1 1 0 01-1.414 0l-3-3a1 1 0 010-1.414z" clip-rule="evenodd" /></svg>
                    Download Extracted PEM Files
                </button>
            </div>

            <button onclick="switchTab('localTab')" class="mt-6 mx-auto block text-xs text-slate-400 hover:text-emerald-500 transition-colors underline underline-offset-2 decoration-dotted">Powered by WebAssembly OpenSSL &mdash; no data ever leaves your machine. Learn how &rarr;</button>
        </div>

        <div id="decoderTab" class="max-w-4xl mx-auto hidden">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-800 mb-2">Certificate Decoder</h2>
                <p class="text-slate-500 leading-relaxed">Paste a PEM encoded SSL certificate below, or load one from your Memory Vault.</p>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col">
                <div class="bg-blue-600 px-4 py-3 flex items-center justify-between">
                    <h3 class="text-white font-medium text-sm">Paste Certificate Chain (PEM)</h3>
                    
                    <select id="decoderVaultSelect" class="text-xs rounded border-0 py-1.5 px-3 text-slate-800 bg-white/90 hover:bg-white focus:ring-0 cursor-pointer max-w-[200px] truncate shadow-sm">
                        <option value="">📥 Load from Vault...</option>
                    </select>

                </div>
                <textarea id="pemInput" spellcheck="false" class="w-full h-48 p-4 font-mono text-xs text-slate-700 focus:outline-none focus:ring-0 resize-none bg-slate-50" placeholder="-----BEGIN CERTIFICATE-----&#10;MIIG2TCCB...&#10;...&#10;-----END CERTIFICATE-----"></textarea>
            </div>

            <div id="decodeLoader" class="hidden mt-6 text-sm text-slate-500 flex items-center gap-2">
                <svg class="animate-spin h-4 w-4 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                Decoding Chain...
            </div>

            <div id="decodeResults" class="mt-8 space-y-4"></div>
        </div>

        <div id="matcherTab" class="max-w-5xl mx-auto hidden">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-800 mb-2">Key & Cert Matcher</h2>
                <p class="text-slate-500 leading-relaxed">Paste any combination of a Certificate, Private Key, or CSR below. We will extract the public keys from both and verify if they belong to the same cryptographic pair.</p>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-6">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col">
                    <div class="bg-slate-700 px-4 py-3 flex items-center justify-between">
                        <h3 class="text-white font-medium text-sm">Input 1</h3>
                        <select id="match1VaultSelect" class="text-xs rounded border-0 py-1 px-2 text-slate-800 bg-white/90 hover:bg-white cursor-pointer max-w-[150px] truncate shadow-sm">
                            <option value="">📥 Load Vault...</option>
                        </select>
                    </div>
                    <textarea id="matchInput1" spellcheck="false" class="w-full h-64 p-4 font-mono text-xs text-slate-700 focus:outline-none focus:ring-0 resize-none bg-slate-50" placeholder="Paste Cert, Key, or CSR PEM..."></textarea>
                </div>
                
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col">
                    <div class="bg-slate-700 px-4 py-3 flex items-center justify-between">
                        <h3 class="text-white font-medium text-sm">Input 2</h3>
                        <select id="match2VaultSelect" class="text-xs rounded border-0 py-1 px-2 text-slate-800 bg-white/90 hover:bg-white cursor-pointer max-w-[150px] truncate shadow-sm">
                            <option value="">📥 Load Vault...</option>
                        </select>
                    </div>
                    <textarea id="matchInput2" spellcheck="false" class="w-full h-64 p-4 font-mono text-xs text-slate-700 focus:outline-none focus:ring-0 resize-none bg-slate-50" placeholder="Paste Cert, Key, or CSR PEM..."></textarea>
                </div>
            </div>

            <div class="max-w-md mx-auto bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
                <div class="mb-4">
                    <label for="matchPass" class="block text-sm font-semibold text-slate-700 mb-1.5">Private Key Password (Optional)</label>
                    <input type="password" id="matchPass" placeholder="Leave blank if key is unencrypted" 
                        class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all text-sm">
                </div>
                <button id="compareBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg shadow-sm transition-colors disabled:opacity-50 flex justify-center items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
                    Compare Inputs
                </button>
            </div>

            <div id="matchResult" class="mt-6 max-w-md mx-auto hidden"></div>
        </div>

        <div id="converterTab" class="max-w-2xl mx-auto hidden">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-800 mb-2">Certificate Converter</h2>
                <p class="text-slate-500 leading-relaxed">Convert SSL certificates to and from different formats (PEM, DER, P7B, PFX) natively in your browser.</p>
            </div>

            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8 space-y-5">
                
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Current Format</label>
                        <select id="convFromType" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm bg-white">
                            <option value="pem">Standard PEM</option>
                            <option value="der">DER / Binary</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5">Target Format</label>
                        <select id="convToType" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm bg-white">
                            <option value="der">DER / Binary</option>
                            <option value="pem">Standard PEM</option>
                            <option value="p7b">P7B / PKCS#7</option>
                            <option value="pfx">PFX / PKCS#12</option>
                        </select>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5">Certificate Source</label>
                    <div class="flex items-center gap-3">
                        <select id="convCertVaultSelect" class="flex-1 px-4 py-2.5 rounded-lg border border-slate-300 text-sm focus:ring-2 focus:ring-blue-500 outline-none bg-white">
                            <option value="">-- Load from Vault --</option>
                        </select>
                        <span class="text-xs font-bold text-slate-400">OR</span>
                        <input type="file" id="convFile" class="flex-1 text-sm text-slate-500 file:mr-4 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200 border border-slate-200 rounded-lg cursor-pointer transition-all bg-slate-50">
                    </div>
                </div>

                <div id="convKeyGroup" class="hidden pt-4 border-t border-slate-100">
                    <label class="block text-sm font-semibold text-slate-700 mb-1.5 text-blue-600">Private Key Source (Required for PFX)</label>
                    <div class="flex items-center gap-3">
                        <select id="convKeyVaultSelect" class="flex-1 px-4 py-2.5 rounded-lg border border-slate-300 text-sm focus:ring-2 focus:ring-blue-500 outline-none bg-white">
                            <option value="">-- Load from Vault --</option>
                        </select>
                        <span class="text-xs font-bold text-slate-400">OR</span>
                        <input type="file" id="convKeyFile" class="flex-1 text-sm text-slate-500 file:mr-4 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200 border border-slate-200 rounded-lg cursor-pointer transition-all bg-slate-50">
                    </div>
                    
                    <div class="mt-4">
                        <label class="block text-sm font-semibold text-slate-700 mb-1.5">New PFX Password</label>
                        <input type="password" id="convPass" placeholder="Set a password for the new PFX" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm">
                    </div>
                </div>

                <button id="convertBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg shadow-sm transition-colors disabled:opacity-50 mt-4 flex justify-center items-center gap-2">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7h12m0 0l-4-4m4 4l-4 4m0 6H4m0 0l4 4m-4-4l4-4" /></svg>
                    Convert Certificate
                </button>
                <div id="convStatus" class="text-center font-medium mt-4 text-sm hidden"></div>
            </div>
        </div>

        <!-- CSR Generator Tab -->
        <div id="csrTab" class="max-w-2xl mx-auto hidden">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-800 mb-2">CSR Generator &amp; Decoder</h2>
                <p class="text-slate-500 leading-relaxed">Generate Certificate Signing Requests or decode existing CSRs. All operations run locally via WebAssembly.</p>
            </div>
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8 space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Common Name (CN) *</label><input type="text" id="csrCN" placeholder="example.com" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm"></div>
                    <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Organization (O)</label><input type="text" id="csrO" placeholder="My Company" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm"></div>
                </div>
                <div class="grid grid-cols-3 gap-4">
                    <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">OU</label><input type="text" id="csrOU" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm"></div>
                    <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Locality (L)</label><input type="text" id="csrL" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm"></div>
                    <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">State (ST)</label><input type="text" id="csrST" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm"></div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Country (C)</label><input type="text" id="csrC" maxlength="2" placeholder="US" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm"></div>
                    <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Key Type</label>
                        <select id="csrKeyType" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm bg-white">
                            <option value="rsa2048">RSA 2048</option><option value="rsa4096">RSA 4096</option><option value="ecp256">EC P-256</option><option value="ecp384">EC P-384</option>
                        </select>
                    </div>
                </div>
                <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Subject Alternative Names (comma-separated)</label><input type="text" id="csrSANs" placeholder="www.example.com, mail.example.com, 10.0.0.1" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm"></div>
                <button id="csrGenerateBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg shadow-sm transition-colors disabled:opacity-50">Generate CSR &amp; Key</button>
                <div id="csrStatus" class="text-center font-medium mt-4 text-sm hidden"></div>
            </div>
            <div id="csrResults" class="hidden mt-6 space-y-4">
                <div><h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Certificate Signing Request</h4><pre id="csrOutputCSR" class="bg-slate-800 text-emerald-400 rounded-lg p-4 text-xs font-mono overflow-x-auto whitespace-pre-wrap break-words max-h-64 overflow-y-auto"></pre><button id="csrDownloadCSR" class="mt-2 text-sm text-blue-600 hover:text-blue-800 font-semibold">Download CSR</button></div>
                <div><h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Private Key</h4><pre id="csrOutputKey" class="bg-slate-800 text-amber-400 rounded-lg p-4 text-xs font-mono overflow-x-auto whitespace-pre-wrap break-words max-h-64 overflow-y-auto"></pre><button id="csrDownloadKey" class="mt-2 text-sm text-blue-600 hover:text-blue-800 font-semibold">Download Key</button></div>
            </div>
            <div class="mt-8 border-t border-slate-200 pt-8">
                <h3 class="text-lg font-bold text-slate-800 mb-4">Decode Existing CSR</h3>
                <textarea id="csrDecodeInput" spellcheck="false" class="w-full h-40 p-4 font-mono text-xs text-slate-700 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none bg-slate-50" placeholder="-----BEGIN CERTIFICATE REQUEST-----&#10;...&#10;-----END CERTIFICATE REQUEST-----"></textarea>
                <button id="csrDecodeBtn" class="mt-3 bg-slate-700 hover:bg-slate-800 text-white font-semibold py-2.5 px-4 rounded-lg text-sm">Decode CSR</button>
                <div id="csrDecodeResults" class="mt-4"></div>
            </div>
        </div>

        <!-- JWT Tab -->
        <div id="jwtTab" class="max-w-3xl mx-auto hidden">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-800 mb-2">JWT Tools</h2>
                <p class="text-slate-500 leading-relaxed">Decode, inspect, and verify JSON Web Tokens. Everything runs in your browser using the Web Crypto API.</p>
            </div>
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col">
                <div class="bg-indigo-600 px-4 py-3"><h3 class="text-white font-medium text-sm">Paste JWT</h3></div>
                <textarea id="jwtInput" spellcheck="false" class="w-full h-32 p-4 font-mono text-xs text-slate-700 focus:outline-none resize-none bg-slate-50" placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.dozjgNryP4J3jVmNHl0w5N_XgL0n3I9PlFUP0THsR8U"></textarea>
            </div>
            <div id="jwtResults" class="mt-6"></div>
            <div class="mt-6 bg-white rounded-2xl shadow-sm border border-slate-200 p-6">
                <h4 class="font-bold text-slate-700 text-sm mb-3">Verify Signature</h4>
                <textarea id="jwtVerifyKey" spellcheck="false" class="w-full h-24 p-3 font-mono text-xs text-slate-700 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none bg-slate-50 mb-3" placeholder="Paste public key (PEM) or shared secret for HMAC..."></textarea>
                <button id="jwtVerifyBtn" class="bg-indigo-600 hover:bg-indigo-700 text-white font-semibold py-2.5 px-4 rounded-lg text-sm">Verify</button>
            </div>
        </div>

        <!-- SSH Tab -->
        <div id="sshTab" class="max-w-2xl mx-auto hidden">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-800 mb-2">SSH Key Generator</h2>
                <p class="text-slate-500 leading-relaxed">Generate SSH key pairs using OpenSSL WASM. Ed25519 is not available in this build.</p>
            </div>
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8 space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Key Type</label>
                        <select id="sshKeyType" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm bg-white">
                            <option value="rsa2048">RSA 2048</option><option value="rsa4096">RSA 4096</option><option value="ecdsa256">ECDSA P-256</option><option value="ecdsa384">ECDSA P-384</option>
                        </select>
                    </div>
                    <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Comment</label><input type="text" id="sshComment" placeholder="user@host" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm"></div>
                </div>
                <button id="sshGenerateBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg shadow-sm transition-colors disabled:opacity-50">Generate SSH Key Pair</button>
                <div id="sshStatus" class="text-center font-medium mt-4 text-sm hidden"></div>
            </div>
            <div id="sshResults" class="hidden mt-6 space-y-4">
                <div><h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">SSH Public Key</h4><pre id="sshOutputSSH" class="bg-slate-800 text-emerald-400 rounded-lg p-4 text-xs font-mono overflow-x-auto whitespace-pre-wrap break-words"></pre><button id="sshDownloadPublic" class="mt-2 text-sm text-blue-600 hover:text-blue-800 font-semibold">Download Public Key</button></div>
                <div><h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">PEM Public Key</h4><pre id="sshOutputPublic" class="bg-slate-800 text-blue-400 rounded-lg p-4 text-xs font-mono overflow-x-auto whitespace-pre-wrap break-words max-h-48 overflow-y-auto"></pre></div>
                <div><h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Private Key</h4><pre id="sshOutputPrivate" class="bg-slate-800 text-amber-400 rounded-lg p-4 text-xs font-mono overflow-x-auto whitespace-pre-wrap break-words max-h-48 overflow-y-auto"></pre><button id="sshDownloadPrivate" class="mt-2 text-sm text-blue-600 hover:text-blue-800 font-semibold">Download Private Key</button></div>
            </div>
        </div>

        <!-- ASN.1 Tab -->
        <div id="asn1Tab" class="max-w-3xl mx-auto hidden">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-800 mb-2">ASN.1 Parser</h2>
                <p class="text-slate-500 leading-relaxed">Parse and display ASN.1 structures from PEM or DER input using OpenSSL WASM.</p>
            </div>
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 space-y-4">
                <textarea id="asn1Input" spellcheck="false" class="w-full h-40 p-4 font-mono text-xs text-slate-700 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none bg-slate-50" placeholder="Paste PEM data (certificate, key, CSR)..."></textarea>
                <div class="flex gap-3">
                    <button id="asn1ParseBtn" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-4 rounded-lg text-sm">Parse PEM</button>
                    <label class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold py-2.5 px-4 rounded-lg text-sm cursor-pointer">Upload DER File<input type="file" id="asn1File" class="hidden"></label>
                </div>
            </div>
            <div id="asn1Results" class="mt-6"></div>
        </div>

        <!-- PGP Tab -->
        <div id="pgpTab" class="max-w-2xl mx-auto hidden">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-800 mb-2">PGP Key Tools</h2>
                <p class="text-slate-500 leading-relaxed">Generate and inspect PGP/GPG keys using OpenPGP.js. All operations run locally.</p>
            </div>
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 sm:p-8 space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Name *</label><input type="text" id="pgpName" placeholder="Jane Doe" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm"></div>
                    <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Email *</label><input type="email" id="pgpEmail" placeholder="jane@example.com" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm"></div>
                </div>
                <div class="grid grid-cols-2 gap-4">
                    <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Key Type</label>
                        <select id="pgpKeyType" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm bg-white">
                            <option value="ecc">ECC (Curve25519)</option><option value="rsa2048">RSA 2048</option><option value="rsa4096">RSA 4096</option>
                        </select>
                    </div>
                    <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Passphrase (optional)</label><input type="password" id="pgpPassphrase" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm"></div>
                </div>
                <button id="pgpGenerateBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg shadow-sm transition-colors disabled:opacity-50">Generate PGP Key Pair</button>
                <div id="pgpStatus" class="text-center font-medium mt-4 text-sm hidden"></div>
            </div>
            <div id="pgpResults" class="hidden mt-6 space-y-4">
                <div class="bg-white border border-slate-200 rounded-lg overflow-hidden text-sm">
                    <dl class="divide-y divide-slate-100">
                        <div class="px-4 py-3 sm:grid sm:grid-cols-3 sm:gap-4"><dt class="font-medium text-slate-500">Fingerprint</dt><dd id="pgpFingerprint" class="text-slate-900 sm:col-span-2 font-mono text-xs">-</dd></div>
                        <div class="px-4 py-3 sm:grid sm:grid-cols-3 sm:gap-4 bg-slate-50"><dt class="font-medium text-slate-500">Algorithm</dt><dd id="pgpAlgorithm" class="text-slate-900 sm:col-span-2">-</dd></div>
                        <div class="px-4 py-3 sm:grid sm:grid-cols-3 sm:gap-4"><dt class="font-medium text-slate-500">Created</dt><dd id="pgpCreated" class="text-slate-900 sm:col-span-2">-</dd></div>
                    </dl>
                </div>
                <div><h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Public Key</h4><pre id="pgpOutputPublic" class="bg-slate-800 text-emerald-400 rounded-lg p-4 text-xs font-mono overflow-x-auto whitespace-pre-wrap break-words max-h-48 overflow-y-auto"></pre><button id="pgpDownloadPublic" class="mt-2 text-sm text-blue-600 hover:text-blue-800 font-semibold">Download Public Key</button></div>
                <div><h4 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-2">Private Key</h4><pre id="pgpOutputPrivate" class="bg-slate-800 text-amber-400 rounded-lg p-4 text-xs font-mono overflow-x-auto whitespace-pre-wrap break-words max-h-48 overflow-y-auto"></pre><button id="pgpDownloadPrivate" class="mt-2 text-sm text-blue-600 hover:text-blue-800 font-semibold">Download Private Key</button></div>
            </div>
            <div class="mt-8 border-t border-slate-200 pt-8">
                <h3 class="text-lg font-bold text-slate-800 mb-4">Inspect PGP Key</h3>
                <textarea id="pgpInspectInput" spellcheck="false" class="w-full h-40 p-4 font-mono text-xs text-slate-700 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none bg-slate-50" placeholder="Paste armored PGP public key..."></textarea>
                <button id="pgpInspectBtn" class="mt-3 bg-slate-700 hover:bg-slate-800 text-white font-semibold py-2.5 px-4 rounded-lg text-sm">Inspect Key</button>
                <div id="pgpInspectResults" class="mt-4"></div>
            </div>
        </div>

        <!-- Cipher Suites Tab -->
        <div id="ciphersTab" class="max-w-5xl mx-auto hidden">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-800 mb-2">Cipher Suite Reference</h2>
                <p class="text-slate-500 leading-relaxed">View all cipher suites supported by OpenSSL. Weak or deprecated suites are flagged.</p>
            </div>
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 flex gap-4 items-end">
                <div class="flex-1"><label class="block text-sm font-semibold text-slate-700 mb-1.5">Filter</label><input type="text" id="cipherSearch" placeholder="Search cipher suites..." class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm"></div>
                <button id="cipherLoadBtn" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-6 rounded-lg text-sm shrink-0">Load Cipher Suites</button>
            </div>
            <div id="cipherResults" class="mt-6"></div>
        </div>

        <!-- OCSP Tab -->
        <div id="ocspTab" class="max-w-2xl mx-auto hidden">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-800 mb-2">OCSP / CRL Checker</h2>
                <p class="text-slate-500 leading-relaxed">Check certificate revocation status via OCSP. Requires the API proxy.</p>
            </div>
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 space-y-4">
                <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Certificate (PEM)</label><textarea id="ocspCert" spellcheck="false" class="w-full h-32 p-3 font-mono text-xs border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none bg-slate-50" placeholder="Paste leaf certificate PEM..."></textarea></div>
                <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Issuer Certificate (PEM, optional)</label><textarea id="ocspIssuer" spellcheck="false" class="w-full h-24 p-3 font-mono text-xs border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none bg-slate-50" placeholder="Paste issuer certificate PEM..."></textarea></div>
                <button id="ocspCheckBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg shadow-sm transition-colors disabled:opacity-50">Check Revocation Status</button>
            </div>
            <div id="ocspResults" class="mt-6"></div>
        </div>

        <!-- Encoder Tab -->
        <div id="encoderTab" class="max-w-3xl mx-auto hidden">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-800 mb-2">Encoder / Decoder</h2>
                <p class="text-slate-500 leading-relaxed">Convert text between Base64, URL encoding, HTML entities, Hex, and more.</p>
            </div>
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Mode</label>
                        <select id="encoderMode" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm bg-white">
                            <option value="base64">Base64</option><option value="base64url">Base64URL</option><option value="url">URL Encoding</option><option value="html">HTML Entities</option><option value="hex">Hex</option>
                        </select>
                    </div>
                    <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Direction</label>
                        <select id="encoderDirection" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm bg-white">
                            <option value="encode">Encode</option><option value="decode">Decode</option>
                        </select>
                    </div>
                </div>
                <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Input</label><textarea id="encoderInput" class="w-full h-32 p-4 font-mono text-xs text-slate-700 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none bg-slate-50" placeholder="Type or paste text..."></textarea></div>
                <div class="flex gap-3 items-center"><label class="bg-slate-200 hover:bg-slate-300 text-slate-700 font-semibold py-2 px-4 rounded-lg text-sm cursor-pointer">Upload File<input type="file" id="encoderFile" class="hidden"></label><span id="encoderStatus" class="text-xs text-red-600"></span></div>
                <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Output</label><textarea id="encoderOutput" readonly class="w-full h-32 p-4 font-mono text-xs text-slate-700 border border-slate-200 rounded-lg bg-slate-50 resize-none"></textarea></div>
                <button id="encoderCopy" class="text-sm text-blue-600 hover:text-blue-800 font-semibold">Copy Output</button>
            </div>
        </div>

        <!-- Hash Tab -->
        <div id="hashTab" class="max-w-3xl mx-auto hidden">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-800 mb-2">Hash Generator</h2>
                <p class="text-slate-500 leading-relaxed">Compute MD5, SHA-1, SHA-256, SHA-384, SHA-512, and HMAC hashes. MD5 uses OpenSSL WASM; SHA family uses Web Crypto.</p>
            </div>
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 space-y-4">
                <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Text Input</label><textarea id="hashInput" class="w-full h-32 p-4 font-mono text-xs text-slate-700 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none bg-slate-50" placeholder="Enter text to hash..."></textarea></div>
                <div class="flex gap-3 items-center">
                    <label class="block text-sm font-semibold text-slate-700">Or select a file:</label>
                    <input type="file" id="hashFile" class="text-sm text-slate-500 file:mr-4 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-slate-100 file:text-slate-700 hover:file:bg-slate-200 border border-slate-200 rounded-lg cursor-pointer bg-slate-50">
                </div>
                <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">HMAC Key (optional)</label><input type="text" id="hashHmacKey" placeholder="Enter HMAC secret key" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm"></div>
                <button id="hashBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg shadow-sm transition-colors">Compute Hashes</button>
            </div>
            <div id="hashResults" class="mt-6"></div>
            <div class="mt-8 border-t border-slate-200 pt-8">
                <h3 class="text-lg font-bold text-slate-800 mb-4">Compare Hashes</h3>
                <div class="grid grid-cols-2 gap-4">
                    <input type="text" id="hashCompare1" placeholder="Hash 1" class="px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm font-mono">
                    <input type="text" id="hashCompare2" placeholder="Hash 2" class="px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm font-mono">
                </div>
                <button id="hashCompareBtn" class="mt-3 bg-slate-700 hover:bg-slate-800 text-white font-semibold py-2.5 px-4 rounded-lg text-sm">Compare</button>
                <div id="hashCompareResult" class="mt-3"></div>
            </div>
        </div>

        <!-- Data Converter Tab -->
        <div id="dataconvTab" class="max-w-3xl mx-auto hidden">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-800 mb-2">Data Format Converter</h2>
                <p class="text-slate-500 leading-relaxed">Convert between JSON, YAML, XML, and CSV. Beautify or minify JSON.</p>
            </div>
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 space-y-4">
                <div class="grid grid-cols-2 gap-4">
                    <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">From</label>
                        <select id="dataconvFrom" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm bg-white">
                            <option value="auto">Auto-detect</option><option value="json">JSON</option><option value="yaml">YAML</option><option value="xml">XML</option><option value="csv">CSV</option>
                        </select>
                    </div>
                    <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">To</label>
                        <select id="dataconvTo" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm bg-white">
                            <option value="json">JSON (pretty)</option><option value="json-min">JSON (minified)</option><option value="yaml">YAML</option><option value="xml">XML</option><option value="csv">CSV</option>
                        </select>
                    </div>
                </div>
                <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Input</label><textarea id="dataconvInput" class="w-full h-40 p-4 font-mono text-xs text-slate-700 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none bg-slate-50" placeholder="Paste data here..."></textarea></div>
                <button id="dataconvConvertBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg shadow-sm transition-colors">Convert</button>
                <p id="dataconvStatus" class="text-xs mt-2"></p>
                <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Output</label><textarea id="dataconvOutput" readonly class="w-full h-40 p-4 font-mono text-xs text-slate-700 border border-slate-200 rounded-lg bg-slate-50 resize-none"></textarea></div>
                <button id="dataconvCopy" class="text-sm text-blue-600 hover:text-blue-800 font-semibold">Copy Output</button>
            </div>
        </div>

        <!-- Regex Tab -->
        <div id="regexTab" class="max-w-3xl mx-auto hidden">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-800 mb-2">Regex Tester</h2>
                <p class="text-slate-500 leading-relaxed">Test regular expressions with real-time match highlighting and capture group display.</p>
            </div>
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 space-y-4">
                <div class="flex gap-3">
                    <div class="flex-1"><label class="block text-sm font-semibold text-slate-700 mb-1.5">Pattern</label><input type="text" id="regexPattern" placeholder="[a-z]+" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm font-mono"></div>
                    <div class="w-24"><label class="block text-sm font-semibold text-slate-700 mb-1.5">Flags</label><input type="text" id="regexFlags" value="g" placeholder="gim" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm font-mono"></div>
                </div>
                <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Test String</label><textarea id="regexTestString" class="w-full h-32 p-4 font-mono text-xs text-slate-700 border border-slate-200 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 resize-none bg-slate-50" placeholder="Enter text to test against..."></textarea></div>
                <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Highlighted</label><div id="regexHighlight" class="w-full min-h-[80px] p-4 font-mono text-xs text-slate-700 border border-slate-200 rounded-lg bg-white whitespace-pre-wrap break-words"></div></div>
            </div>
            <div id="regexResults" class="mt-6"></div>
        </div>

        <!-- Diff Tab -->
        <div id="diffTab" class="max-w-5xl mx-auto hidden">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-800 mb-2">Text Diff</h2>
                <p class="text-slate-500 leading-relaxed">Compare two text inputs and see additions and removals highlighted.</p>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col">
                    <div class="bg-slate-700 px-4 py-3"><h3 class="text-white font-medium text-sm">Original</h3></div>
                    <textarea id="diffLeft" spellcheck="false" class="w-full h-64 p-4 font-mono text-xs text-slate-700 focus:outline-none resize-none bg-slate-50" placeholder="Paste original text..."></textarea>
                </div>
                <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden flex flex-col">
                    <div class="bg-slate-700 px-4 py-3"><h3 class="text-white font-medium text-sm">Modified</h3></div>
                    <textarea id="diffRight" spellcheck="false" class="w-full h-64 p-4 font-mono text-xs text-slate-700 focus:outline-none resize-none bg-slate-50" placeholder="Paste modified text..."></textarea>
                </div>
            </div>
            <button id="diffCompareBtn" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-6 rounded-lg text-sm">Compare</button>
            <div id="diffResults" class="mt-6"></div>
        </div>

        <!-- UUID Tab -->
        <div id="uuidTab" class="max-w-2xl mx-auto hidden">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-800 mb-2">UUID &amp; Random Generator</h2>
                <p class="text-slate-500 leading-relaxed">Generate UUIDs (v4, v7), random hex, base64, and byte sequences using crypto.getRandomValues().</p>
            </div>
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 space-y-4">
                <div class="grid grid-cols-3 gap-4">
                    <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Type</label>
                        <select id="uuidType" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm bg-white">
                            <option value="uuidv4">UUID v4</option><option value="uuidv7">UUID v7</option><option value="hex">Random Hex</option><option value="base64">Random Base64</option><option value="bytes">Random Bytes</option>
                        </select>
                    </div>
                    <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Count</label><input type="number" id="uuidCount" value="1" min="1" max="1000" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm"></div>
                    <div id="uuidLengthGroup" class="hidden"><label class="block text-sm font-semibold text-slate-700 mb-1.5">Length</label><input type="number" id="uuidLength" value="32" min="1" max="1024" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm"></div>
                </div>
                <button id="uuidGenerateBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg shadow-sm transition-colors">Generate</button>
                <textarea id="uuidOutput" readonly class="w-full h-40 p-4 font-mono text-xs text-slate-700 border border-slate-200 rounded-lg bg-slate-50 resize-none"></textarea>
                <button id="uuidCopy" class="text-sm text-blue-600 hover:text-blue-800 font-semibold">Copy Output</button>
            </div>
        </div>

        <!-- DNS Tab -->
        <div id="dnsTab" class="max-w-3xl mx-auto hidden">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-800 mb-2">DNS Lookup</h2>
                <p class="text-slate-500 leading-relaxed">Query DNS records via the API proxy (Cloudflare DNS-over-HTTPS).</p>
            </div>
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 flex gap-4 items-end">
                <div class="flex-1"><label class="block text-sm font-semibold text-slate-700 mb-1.5">Domain</label><input type="text" id="dnsDomain" placeholder="example.com" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm"></div>
                <div class="w-32"><label class="block text-sm font-semibold text-slate-700 mb-1.5">Type</label><select id="dnsRecordType" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm bg-white"></select></div>
                <button id="dnsLookupBtn" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-6 rounded-lg text-sm shrink-0">Lookup</button>
            </div>
            <div id="dnsResults" class="mt-6"></div>
        </div>

        <!-- SSL Check Tab -->
        <div id="sslcheckTab" class="max-w-3xl mx-auto hidden">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-800 mb-2">SSL/TLS Certificate Checker</h2>
                <p class="text-slate-500 leading-relaxed">Inspect a remote server's SSL certificate chain, TLS version, and cipher suite via the API proxy.</p>
            </div>
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 flex gap-4 items-end">
                <div class="flex-1"><label class="block text-sm font-semibold text-slate-700 mb-1.5">Hostname</label><input type="text" id="sslHost" placeholder="example.com" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm"></div>
                <div class="w-24"><label class="block text-sm font-semibold text-slate-700 mb-1.5">Port</label><input type="text" id="sslPort" value="443" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm"></div>
                <button id="sslCheckBtn" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-6 rounded-lg text-sm shrink-0">Check SSL</button>
            </div>
            <div id="sslResults" class="mt-6"></div>
        </div>

        <!-- HTTP Headers Tab -->
        <div id="headersTab" class="max-w-3xl mx-auto hidden">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-800 mb-2">HTTP Header Analyzer</h2>
                <p class="text-slate-500 leading-relaxed">Inspect response headers and score security header configuration via the API proxy.</p>
            </div>
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 flex gap-4 items-end">
                <div class="flex-1"><label class="block text-sm font-semibold text-slate-700 mb-1.5">URL</label><input type="text" id="headersUrl" placeholder="https://example.com" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm"></div>
                <button id="headersCheckBtn" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-6 rounded-lg text-sm shrink-0">Analyze</button>
            </div>
            <div id="headersResults" class="mt-6"></div>
        </div>

        <!-- WHOIS Tab -->
        <div id="whoisTab" class="max-w-3xl mx-auto hidden">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-800 mb-2">WHOIS Lookup</h2>
                <p class="text-slate-500 leading-relaxed">Query domain registration information via the API proxy.</p>
            </div>
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 flex gap-4 items-end">
                <div class="flex-1"><label class="block text-sm font-semibold text-slate-700 mb-1.5">Domain</label><input type="text" id="whoisDomain" placeholder="example.com" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm"></div>
                <button id="whoisLookupBtn" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-6 rounded-lg text-sm shrink-0">Lookup</button>
            </div>
            <div id="whoisResults" class="mt-6"></div>
        </div>

        <!-- Mail Tester Tab -->
        <div id="mailTab" class="max-w-3xl mx-auto hidden">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-800 mb-2">Mail Server Tester</h2>
                <p class="text-slate-500 leading-relaxed">Check MX records, SMTP connectivity, STARTTLS, SPF, DKIM, and DMARC via the API proxy. Port 25 is blocked on Cloudflare Workers.</p>
            </div>
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 flex gap-4 items-end">
                <div class="flex-1"><label class="block text-sm font-semibold text-slate-700 mb-1.5">Domain</label><input type="text" id="mailDomain" placeholder="example.com" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm"></div>
                <button id="mailCheckBtn" class="bg-blue-600 hover:bg-blue-700 text-white font-semibold py-2.5 px-6 rounded-lg text-sm shrink-0">Test Mail Server</button>
            </div>
            <div id="mailResults" class="mt-6"></div>
        </div>

        <!-- Port Scanner Tab -->
        <div id="portscanTab" class="max-w-3xl mx-auto hidden">
            <div class="mb-8">
                <h2 class="text-3xl font-bold text-slate-800 mb-2">Port Scanner</h2>
                <p class="text-slate-500 leading-relaxed">Test TCP port connectivity via the API proxy. Maximum 20 ports per scan.</p>
            </div>
            <div class="bg-white rounded-2xl shadow-sm border border-slate-200 p-6 space-y-4">
                <div class="flex gap-4">
                    <div class="flex-1"><label class="block text-sm font-semibold text-slate-700 mb-1.5">Hostname / IP</label><input type="text" id="portscanHost" placeholder="example.com" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm"></div>
                    <div class="w-40"><label class="block text-sm font-semibold text-slate-700 mb-1.5">Preset</label>
                        <select id="portscanPreset" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm bg-white">
                            <option value="">Custom</option><option value="web">Web (80, 443, 8080, 8443)</option><option value="mail">Mail (25, 110, 143, 465, 587, 993, 995)</option><option value="database">Database (3306, 5432, 1433, 27017, 6379)</option><option value="remote">Remote (22, 23, 3389, 5900)</option>
                        </select>
                    </div>
                </div>
                <div><label class="block text-sm font-semibold text-slate-700 mb-1.5">Ports (comma-separated)</label><input type="text" id="portscanPorts" placeholder="80, 443, 22, 3389" class="w-full px-4 py-2.5 rounded-lg border border-slate-300 focus:ring-2 focus:ring-blue-500 outline-none text-sm"></div>
                <button id="portscanBtn" class="w-full bg-blue-600 hover:bg-blue-700 text-white font-semibold py-3 px-4 rounded-lg shadow-sm transition-colors disabled:opacity-50">Scan Ports</button>
            </div>
            <div id="portscanResults" class="mt-6"></div>
        </div>

    </div>

    <script type="module" src="js/main.js"></script>
    
    <style> details > summary { list-style: none; } details > summary::-webkit-details-marker { display: none; } </style>
</body>
</html>
