            <button onclick="switchTab('asn1Tab')" id="nav-asn1Tab" class="w-full flex items-center gap-3 px-4 py-2.5 rounded-lg text-slate-300 hover:bg-slate-800 hover:text-white text-sm font-medium transition-colors">
